# ===================
# REQUIRED - Get these first
# ===================

# Discord Bot Token (from Discord Developer Portal)
DISCORD_BOT_TOKEN=your_token_here

# ===================
# BLOCKCHAIN ACCESS
# ===================

# Get free API keys from Alchemy (alchemy.com)
ETH_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_KEY
BASE_RPC_URL=https://base-mainnet.g.alchemy.com/v2/YOUR_KEY

# ===================
# PRICE DATA
# ===================

# CoinGecko API (free tier available at coingecko.com)
COINGECKO_API_KEY=your_key_here

# ===================
# TRADING (Optional - for executing swaps)
# ===================

# 0x API for swap routing (0x.org)
ZERO_X_API_KEY=your_key_here

# Your wallet address (for tracking only - NOT private key!)
WALLET_ADDRESS=0xYourPublicAddressHere

# ===================
# WYDE SPECIFIC
# ===================

# These will be provided by WYDE team
WYDE_TREASURY_ADDRESS=
WYDE_IMPACT_CONTRACT=
